# Local dev defaults. Production values: see docs/backend/DEPLOY.md (set in Render, never committed).
NODE_ENV=development
PORT=3001
# Prod: Supabase "Session pooler" URI (port 5432) with ?sslmode=require. Needed for `prisma migrate deploy`.
DATABASE_URL=postgresql://settled:settled@localhost:5432/settled
# Prod: the public web origin (Vercel URL). Used as the Better Auth base URL and trusted origin.
APP_URL=http://localhost:3000
# Prod: `openssl rand -hex 32`; must match the X-Cron-Secret header set in cron-job.org
CRON_SECRET=change-me-to-a-long-random-string
# Prod: `openssl rand -base64 48`
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-chars-or-more
EMAIL_FROM=Shulam <onboarding@resend.dev>
MAILPIT_URL=http://localhost:8025
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# RESEND_API_KEY=       # unset = Mailpit (local only; set in prod or OTP email will fail)
# R2_ACCOUNT_ID=        # Cloudflare dashboard > R2 > account id
# R2_ACCESS_KEY_ID=     # R2 API token (Object Read & Write, scoped to the bucket)
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# VAPID_PUBLIC_KEY=   # npx web-push generate-vapid-keys
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# MOBILE_ORIGINS=settled://   # native app deep-link scheme(s), comma separated
# EXPO_ACCESS_TOKEN=          # optional, Expo enhanced push security (free)
